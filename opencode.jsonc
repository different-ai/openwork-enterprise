{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "allow",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "question": "allow",
    "external_directory": {
      "*": "allow"
    }
  },
  "model": "openai/gpt-5.5",
  "mcp": {
    "openwork-electron-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl",
        "http://127.0.0.1:9823"
      ]
    },
    "notion": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.notion.com/mcp",
      "oauth": {}
    }
  }
}
